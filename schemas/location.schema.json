{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "location.schema.json",
  "title": "AtelierCatalog Location",
  "description": "Nœud d'une hiérarchie d'emplacements physiques.",
  "type": "object",
  "required": ["id", "name"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "parentId": { "type": ["string", "null"] },
    "type": { "type": ["string", "null"], "description": "Type libre : pièce, meuble, étagère, boîte ou autre." },
    "description": { "type": ["string", "null"] },
    "pathLabel": { "type": ["string", "null"], "description": "Libellé calculable, non identité métier." },
    "notes": { "type": ["string", "null"] }
  }
}
